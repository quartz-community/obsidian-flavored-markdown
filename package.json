{
  "name": "@quartz-community/obsidian-flavored-markdown",
  "version": "2.1.3",
  "description": "Obsidian Flavored Markdown transformer plugin for Quartz",
  "type": "module",
  "license": "MIT",
  "author": "Quartz Community",
  "homepage": "https://github.com/quartz-community/obsidian-flavored-markdown",
  "repository": {
    "type": "git",
    "url": "https://github.com/quartz-community/obsidian-flavored-markdown"
  },
  "keywords": [
    "quartz",
    "quartz-plugin",
    "obsidian",
    "obsidian-flavored-markdown",
    "remark",
    "rehype",
    "mdast",
    "hast"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format && npm run test",
    "prepublishOnly": "npm run build",
    "release": "npm run build && changeset publish",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": false
    }
  },
  "dependencies": {
    "@quartz-community/rehype-obsidian": "^1.3.0",
    "@quartz-community/remark-obsidian": "^2.2.1",
    "@quartz-community/types": "^1.1.0",
    "@quartz-community/utils": "^1.2.0",
    "pele": "^1.13.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.2",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "hast": "^1.0.0",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "mdast": "^3.0.0",
    "mdast-util-to-hast": "^13.2.1",
    "preact": "^10.28.2",
    "prettier": "^3.6.2",
    "rehype-raw": "^7.0.0",
    "sass": "^1.97.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "quartz": {
    "name": "obsidian-flavored-markdown",
    "displayName": "Obsidian Flavored Markdown",
    "category": "transformer",
    "version": "1.0.0",
    "quartzVersion": ">=5.1.0",
    "dependencies": [],
    "defaultOrder": 40,
    "defaultEnabled": true,
    "defaultOptions": {
      "preset": "legacy",
      "comments": true,
      "highlight": true,
      "wikilinks": true,
      "callouts": true,
      "mermaid": true,
      "parseTags": true,
      "parseBlockReferences": true,
      "enableInHtmlEmbed": false,
      "enableYouTubeEmbed": true,
      "enableTweetEmbed": true,
      "enableVideoEmbed": true,
      "enableCheckbox": false,
      "enableObsidianUri": true,
      "diagramRenderer": "mermaid"
    },
    "optionSchema": {
      "preset": {
        "type": "string",
        "enum": [
          "legacy",
          "strict"
        ]
      },
      "strictLineBreaks": {
        "type": "boolean"
      },
      "comments": {
        "type": "boolean"
      },
      "highlight": {
        "type": "boolean"
      },
      "wikilinks": {
        "type": "boolean"
      },
      "callouts": {
        "type": "boolean"
      },
      "mermaid": {
        "type": "boolean"
      },
      "parseTags": {
        "type": "boolean"
      },
      "parseBlockReferences": {
        "type": "boolean"
      },
      "enableInHtmlEmbed": {
        "type": "boolean"
      },
      "enableYouTubeEmbed": {
        "type": "boolean"
      },
      "enableTweetEmbed": {
        "type": "boolean"
      },
      "enableVideoEmbed": {
        "type": "boolean"
      },
      "enableCheckbox": {
        "type": "boolean"
      },
      "enableObsidianUri": {
        "type": "boolean"
      },
      "diagramRenderer": {
        "type": "string",
        "enum": [
          "mermaid",
          "pele"
        ]
      }
    },
    "capabilities": {
      "provides": {
        "data": [
          "hasMermaidDiagram",
          "blocks",
          "htmlAst"
        ],
        "dom": [
          ".callout",
          ".transclude",
          ".mermaid",
          ".expand-button",
          "#mermaid-container"
        ]
      },
      "requires": {
        "data": [
          "slug"
        ],
        "dom": [
          {
            "name": ".internal",
            "from": "crawl-links",
            "reason": "wikilinks and embeds stay page-relative, so links and embedded files (images, SVG, PDF) break"
          }
        ]
      },
      "optional": {
        "data": [
          {
            "name": "frontmatter",
            "from": "note-properties",
            "reason": "inline #tags are not merged into the page tags"
          }
        ],
        "dom": [
          {
            "name": ".clipboard-button",
            "from": "syntax-highlighting",
            "reason": "mermaid expand button is not offset"
          }
        ]
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
